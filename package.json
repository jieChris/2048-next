{
  "name": "2048-next",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "node scripts/dev-local.mjs",
    "dev:cloud-api": "node scripts/dev-cloud-api.mjs",
    "dev:ranked-seed-validator": "node scripts/ranked-seed-validator.mjs",
    "build": "tsc && vite build",
    "preview": "npm run build && node scripts/preview-cloud-api.mjs",
    "preview:raw": "vite preview --open",
    "audit:game-manager": "node scripts/game-manager-audit.mjs",
    "audit:refactor-closure": "node scripts/refactor-closure-audit.mjs",
    "audit:page-legacy-runtime-boundary": "node scripts/page-legacy-runtime-boundary-audit.mjs",
    "test:unit": "vitest run tests/unit",
    "test:unit:core": "vitest run tests/unit/core-",
    "test:unit:watch": "vitest tests/unit",
    "test:smoke": "playwright test --config=playwright.config.ts --workers=1",
    "test:smoke:history": "playwright test --config=playwright.config.ts --workers=1 \"tests/smoke/history-.*\\.smoke\\.spec\\.ts\"",
    "test:smoke:index-ui": "playwright test --config=playwright.config.ts --workers=1 \"tests/smoke/index-ui-.*\\.smoke\\.spec\\.ts\"",
    "test:smoke:pages": "playwright test --config=playwright.config.ts --workers=1 \"tests/smoke/pages-.*\\.smoke\\.spec\\.ts\"",
    "test:smoke:ci": "npm run test:smoke:critical",
    "test:smoke:runtime-contract": "playwright test --config=playwright.config.ts tests/smoke/pages-runtime-contract.smoke.spec.ts",
    "test:smoke:replay-runtime": "playwright test --config=playwright.config.ts tests/smoke/pages-replay-runtime.smoke.spec.ts",
    "test:smoke:history-load": "playwright test --config=playwright.config.ts --workers=1 \"tests/smoke/history-records-.*\\.smoke\\.spec\\.ts\"",
    "test:smoke:play-replay": "playwright test --config=playwright.config.ts tests/smoke/pages-play-modes.smoke.spec.ts tests/smoke/pages-replay-runtime.smoke.spec.ts",
    "test:smoke:recent-regression": "playwright test --config=playwright.config.ts tests/smoke/pages-play-modes.smoke.spec.ts tests/smoke/pages-replay-runtime.smoke.spec.ts \"tests/smoke/history-records-.*\\.smoke\\.spec\\.ts\"",
    "test:smoke:headed": "playwright test --config=playwright.config.ts --headed",
    "test:refactor-contract": "playwright test --config=playwright.refactor-contract.config.ts --workers=1",
    "verify:iterate": "npm run audit:game-manager && npm run test:unit:core && npm run test:smoke:runtime-contract && npm run test:smoke:play-replay",
    "verify:refactor": "node scripts/refactor-gate.mjs",
    "verify:refactor:ci": "node scripts/refactor-gate.mjs --smoke-script=test:smoke:ci",
    "verify:prepush": "npm run verify:refactor:ci",
    "verify:release-ready": "node scripts/release-readiness-check.mjs",
    "verify:release": "npm run verify:refactor:ci && npm run verify:release-ready",
    "verify:submit-ready": "npm run report:commit-split-check && npm run verify:release",
    "report:refactor-progress": "node scripts/refactor-progress-report.mjs",
    "report:commit-split-check": "node scripts/commit-split-check.mjs",
    "report:commit-batch": "node scripts/stage-commit-batch.mjs",
    "audit:quality": "node scripts/quality-audit.mjs",
    "audit:quality:report": "node scripts/quality-audit.mjs --report-markdown",
    "audit:resource-budget": "node scripts/resource-budget-check.mjs",
    "test:unit:tier1": "node scripts/run-tier1.mjs",
    "report:baseline": "node scripts/update-baseline-report.mjs",
    "audit:entry-manifest": "node scripts/entry-manifest-audit.mjs",
    "audit:engine": "node scripts/engine-audit.mjs",
    "audit:service-boundary": "node scripts/service-boundary-audit.mjs",
    "test:smoke:critical": "playwright test --config=playwright.config.ts --workers=1 tests/smoke/pages-runtime-contract.smoke.spec.ts tests/smoke/pages-play-modes.smoke.spec.ts tests/smoke/pages-contracts-saved-session.smoke.spec.ts tests/smoke/pages-play-anti-cheat.smoke.spec.ts tests/smoke/pages-online-submit-persist-retry.smoke.spec.ts tests/smoke/pages-online-submit-timeout-retry.smoke.spec.ts tests/smoke/history-records-import-core.smoke.spec.ts",
    "test:smoke:nightly": "npm run test:smoke"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.0.1",
    "jsdom": "^28.1.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
