# 2048-next Caddy reverse proxy example.
# Replace placeholders before production use.

2048next.example.com {
	root * /var/www/2048-next/current
	encode zstd gzip

	log {
		output file /var/log/caddy/2048-next.access.log {
			roll_size 100MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	@api path /api /api/*
	handle @api {
		reverse_proxy 127.0.0.1:3010 {
			header_up Host {host}
			header_up X-Request-Id {http.request.header.X-Request-Id}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			health_uri /health
			health_interval 30s
			health_timeout 5s
		}
	}

	@code_assets path_regexp code_assets \.(js|mjs|css|wasm)$
	header @code_assets Cache-Control "no-cache"
	header @code_assets Cloudflare-CDN-Cache-Control "public, max-age=300, stale-while-revalidate=300"

	@static path_regexp static \.(png|jpg|jpeg|gif|webp|avif|svg|ico|woff2?|ttf|otf)$
	header @static Cache-Control "public, max-age=31536000, immutable"

	@html path_regexp html ^(?:/|.*\.(?:html|webmanifest))$
	header @html Cache-Control "public, max-age=60, s-maxage=300, stale-while-revalidate=300"
	header @html Cloudflare-CDN-Cache-Control "public, max-age=300, stale-while-revalidate=300"

	handle {
		file_server
	}

	handle_errors {
		@not_found expression {err.status_code} == 404
		rewrite @not_found /404.html
		file_server
	}
}
