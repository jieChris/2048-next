# 2048-next Nginx reverse proxy config for the self-hosted static container.

upstream game_data_api {
    server 2048-game-api:3001;
    keepalive 32;
}

map $uri $browser_cache_control {
    default "no-cache, must-revalidate";
    /admin.html "private, no-store";
    /404.html "private, no-store";
    ~^/api(?:/|$) "";
    /health "";
    /downloads/android/beta/latest-v1.json "no-store";
    ~^/downloads/android/beta/2048-next-[0-9A-Za-z._-]+\.apk$ "public, max-age=31536000, immutable";
    ~*\.(?:png|jpg|jpeg|gif|webp|avif|svg|ico|woff2?|ttf|otf)$ "public, max-age=31536000, immutable";
}

map $uri $cloudflare_cache_control {
    default "public, max-age=60, stale-while-revalidate=300, stale-if-error=86400";
    /admin.html "private, no-store";
    /404.html "private, no-store";
    ~^/api(?:/|$) "";
    /health "";
    /downloads/android/beta/latest-v1.json "no-store";
    ~^/downloads/android/beta/2048-next-[0-9A-Za-z._-]+\.apk$ "public, max-age=31536000, immutable";
    ~*\.(?:js|mjs|css|wasm)$ "public, max-age=300, stale-while-revalidate=300, stale-if-error=86400";
    ~*\.(?:png|jpg|jpeg|gif|webp|avif|svg|ico|woff2?|ttf|otf)$ "public, max-age=31536000, immutable";
}

map $uri $android_beta_cors_origin {
    default "";
    ~^/downloads/android/beta/ "*";
}

# The outer edge proxy rewrites X-Forwarded-Proto, while Cloudflare's original
# visitor scheme remains available in CF-Visitor.
map $http_cf_visitor $cloudflare_visitor_uses_http {
    default 0;
    ~*^\{\"scheme\":\"http\"\}$ 1;
}

# Breakout is intentionally embedded by the same-origin game page.
map $uri $frame_options {
    default DENY;
    ~^/easter-eggs/breakout(?:/|$) SAMEORIGIN;
}

server {
    listen 80;
    server_name 2048next.cn www.2048next.cn _;

    root /usr/share/nginx/html;
    index index.html;
    # The API accepts third-party import files up to 8 MiB; leave room for multipart metadata.
    client_max_body_size 10m;

    access_log /var/log/nginx/2048-next.access.log;
    error_log /var/log/nginx/2048-next.error.log warn;

    if ($cloudflare_visitor_uses_http) {
        return 308 https://2048next.cn$request_uri;
    }

    if ($host = "www.2048next.cn") {
        return 308 https://2048next.cn$request_uri;
    }

    gzip on;
    gzip_static on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types
        application/javascript
        application/json
        application/manifest+json
        application/wasm
        image/svg+xml
        text/css
        text/javascript
        text/plain;
    # If your Nginx build includes ngx_brotli, also enable: brotli_static on;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options $frame_options always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Cache-Control $browser_cache_control always;
    add_header Cloudflare-CDN-Cache-Control $cloudflare_cache_control always;
    add_header Access-Control-Allow-Origin $android_beta_cors_origin always;

    error_page 404 /404.html;

    location = /admin.html {
        auth_request /_admin_page_auth;
        error_page 401 403 =404 /404.html;
        try_files $uri =404;
    }

    location = /_admin_page_auth {
        internal;
        proxy_pass http://game_data_api/api/admin/me;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie "";
        proxy_set_header Authorization "Bearer $cookie_next_admin_session_v1";
        proxy_set_header Host $host;
        proxy_set_header X-Request-Id $request_id;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 10s;
        proxy_read_timeout 10s;
    }

    # Game data and account/auth routes are served by the self-hosted API.
    location = /api {
        proxy_pass http://game_data_api/api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Request-Id $request_id;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    location /api/ {
        proxy_pass http://game_data_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Request-Id $request_id;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    location = /health {
        proxy_pass http://game_data_api/health;
        proxy_set_header Host $host;
        proxy_set_header X-Request-Id $request_id;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~* ^/assets/.*\.(?:js|mjs|css|wasm)$ {
        try_files $uri =404;
    }

    location /assets/ {
        try_files $uri =404;
    }

    location ~* \.(?:js|mjs|css|wasm)$ {
        try_files $uri =404;
    }

    location ~* \.(?:png|jpg|jpeg|gif|webp|avif|svg|ico|woff2?|ttf|otf)$ {
        try_files $uri =404;
    }

    location ~* \.(?:html|webmanifest)$ {
        try_files $uri =404;
    }

    location = / {
        return 308 https://2048next.cn/2048.html$is_args$args;
    }

    location = /index.html {
        return 308 https://2048next.cn/2048.html$is_args$args;
    }

    location = /beta-login.html {
        return 308 https://2048next.cn/2048.html;
    }

    location = /beta-access.html {
        return 308 https://2048next.cn/2048.html;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
