{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node", "vitest/globals"],
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "unit/architecture-budget-check.spec.ts",
    "unit/architecture-budget-baseline-ref.spec.ts",
    "unit/architecture-budget-baseline-selector.spec.ts",
    "unit/architecture-budget-source-path.spec.ts",
    "unit/architecture-budget-exception-boundary.spec.ts",
    "unit/core-load-budget-check.spec.ts",
    "unit/core-load-budget-baseline-ref.spec.ts",
    "unit/core-load-budget-parser.spec.ts",
    "unit/core-performance-budget.spec.ts",
    "unit/core-performance-runner.spec.ts",
    "unit/core-performance-integration.spec.ts",
    "../scripts/architecture-budget-check.mjs",
    "../scripts/architecture-budget/**/*.mjs",
    "../scripts/core-load-budget-check.mjs",
    "../scripts/core-load-budget/**/*.mjs",
    "../scripts/core-performance-check.mjs",
    "../scripts/core-performance/**/*.mjs"
  ]
}
